  <Source dwd:design-time-name="0024bce3-450e-45ea-b118-a78c65f11165">
    <DataSourceViewID>NBA DW</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="02c2f88c-f474-451a-803d-8f0b08defcd7">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE;

CREATE MEMBER CURRENTCUBE.[Measures].[Win Rate] AS IIF([Measures].[Fact Team Game Count] = 0, NULL, [Measures].[Is Win] / [Measures].[Fact Team Game Count]), FORMAT_STRING = '0.00%', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Avg Points] AS IIF([Measures].[Fact Team Game Count] = 0, NULL, [Measures].[Pts] / [Measures].[Fact Team Game Count]), FORMAT_STRING = '0.00', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Avg Plus Minus] AS IIF([Measures].[Fact Team Game Count] = 0, NULL, [Measures].[Plus Minus] / [Measures].[Fact Team Game Count]), FORMAT_STRING = '0.00', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Avg Assists] AS IIF([Measures].[Ast Valid Count] = 0, NULL, [Measures].[Ast] / [Measures].[Ast Valid Count]), FORMAT_STRING = '0.00', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Avg Turnovers] AS IIF([Measures].[Tov Valid Count] = 0, NULL, [Measures].[Tov] / [Measures].[Tov Valid Count]), FORMAT_STRING = '0.00', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Avg 3PM] AS IIF([Measures].[Fg3m Valid Count] = 0, NULL, [Measures].[Fg3m] / [Measures].[Fg3m Valid Count]), FORMAT_STRING = '0.00', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Avg 3PA] AS IIF([Measures].[Fg3a Valid Count] = 0, NULL, [Measures].[Fg3a] / [Measures].[Fg3a Valid Count]), FORMAT_STRING = '0.00', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[3P Accuracy] AS IIF([Measures].[Fg3a] = 0, NULL, [Measures].[Fg3m] / [Measures].[Fg3a]), FORMAT_STRING = '0.00%', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[3P Attempt Share] AS IIF([Measures].[Fga] = 0, NULL, [Measures].[Fg3a] / [Measures].[Fga]), FORMAT_STRING = '0.00%', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Avg Paint Points] AS IIF([Measures].[Paint Valid Count] = 0, NULL, [Measures].[Pts Paint] / [Measures].[Paint Valid Count]), FORMAT_STRING = '0.00', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[FG Accuracy] AS IIF([Measures].[Fga] = 0, NULL, [Measures].[Fgm] / [Measures].[Fga]), FORMAT_STRING = '0.00%', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Avg Fast Break Points] AS IIF([Measures].[Fast Break Valid Count] = 0, NULL, [Measures].[Pts Fast Break] / [Measures].[Fast Break Valid Count]), FORMAT_STRING = '0.00', VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Losses] AS [Measures].[Fact Team Game Count] - [Measures].[Is Win], FORMAT_STRING = '#,##0', VISIBLE = 1;
</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>